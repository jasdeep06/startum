STRATUM_PORT=3000
PREVIEW_PORT=3002
HARNESSROUTER_BASE_URL=http://127.0.0.1:3100/api/harness
# Generated by npm run setup; keep these out of git.
HR_AUTH_USER=stratum
HR_AUTH_PASSWORD=
